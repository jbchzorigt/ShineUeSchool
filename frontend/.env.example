# Backend (FastAPI)-ийн хаяг, клиент (browser)-аас дуудагдана. Хуулж .env.local нэрээр хадгална.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Server component-оос (SSR/build) backend руу дуудах хаяг; өгөгдөөгүй бол NEXT_PUBLIC_API_URL
# хэрэглэнэ. Docker/зэрэгцээ орчинд backend-ийг өөр дотоод хаягаар хүрэх шаардлагатай үед ашиглана.
INTERNAL_API_URL=http://127.0.0.1:8000

# Олон нийтийн сайтын хаяг (share холбоос, OG meta). backend/.env-ийн PUBLIC_SITE_URL-тай тохирно.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
