# Хуулж backend/.env нэрээр хадгална. Байхгүй бол доорх анхдагч утгууд ажиллана.
DATABASE_URL=postgresql+asyncpg://shineue:shineue@localhost:5432/shineue
# (docker-compose.prod.yml ашиглахад DATABASE_URL, MEDIA_DIR-ийг compose өөрөө өгнө)
DATABASE_URL_TEST=postgresql+asyncpg://shineue:shineue@localhost:5432/shineue_test
# Production дээр заавал урт санамсаргүй утга: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me-dev-insecure-change-me-0000
# Таслалаар тусгаарлана
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
MEDIA_DIR=media
ACCESS_TTL_HOURS=8
REFRESH_TTL_DAYS=14
# Facebook (сонголттой). Дөрвийг бүгдийг өгсөн үед л коммент/лайк/автомат пост идэвхжинэ.
FB_APP_ID=
FB_APP_SECRET=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
# Олон нийтийн сайтын хаяг (share, OG, Facebook пост дахь холбоос)
PUBLIC_SITE_URL=http://localhost:3000
VISITOR_TTL_DAYS=30
# Олон нийтэд харагдах backend-ийн хаяг (media зургийн URL-д ашиглана); хоосон бол
# хүсэлтийн request.base_url-г ашиглана (INTERNAL_API_URL нь public хаягаас өөр үед заавал тохируулна)
MEDIA_BASE_URL=
# SMTP (дугуйлангийн бүртгэлийн баталгаажуулах код). SMTP_HOST, SMTP_FROM хоосон бол код
# серверийн логт хэвлэгдэнэ (хөгжүүлэлт). Brevo/Mailgun г.м. SMTP relay-ийн мэдээллийг бичнэ.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
# Дугуйланд бүртгүүлэх имэйлийн домэйн
CLUB_EMAIL_DOMAIN=shineue.edu.mn
